{
  "lastChangelogVersion": "0.84.4",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra"
  ],
  "hideThinkingBlock": false,
  "thinkingBudgets": {
    "minimal": 128,
    "low": 512,
    "medium": 512,
    "high": 4096,
    "xhigh": 8192
  },
  "packages": [
    "git:git@github.com:kyerpotts/pi-default-setup",
    "npm:pi-web-access",
    "npm:pi-show-diffs",
    "npm:@marckrenn/pi-sub-core",
    "npm:@marckrenn/pi-sub-status",
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-llama-cpp",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question"
  ],
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "defaultThinking": "low",
    "agentOverrides": {
      "context-builder": {
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna"
        ]
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna"
        ]
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna"
        ]
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra",
          "openai-codex/gpt-5.6-luna"
        ]
      }
    }
  },
  "theme": "dark",
  "enableInstallTelemetry": false,
  "enableSkillCommands": true,
  "transport": "auto"
}
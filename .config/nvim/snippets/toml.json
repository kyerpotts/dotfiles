{
  "Rust Clippy Lints": {
    "prefix": "clippy",
    "description": "Configure strict Rust Clippy lints",
    "body": [
      "[lints.clippy]",
      "pedantic = { level = \"deny\", priority = -1 }",
      "nursery = { level = \"deny\", priority = -1 }",
      "",
      "# DENY PANICS",
      "",
      "unwrap_used = \"deny\"",
      "expect_used = \"deny\"",
      "indexing_slicing = \"deny\"",
      "arithmetic_side_effects = \"deny\"",
      "unreachable = \"deny\"",
      "",
      "# This can be removed for development",
      "",
      "unimplemented = \"deny\"",
      "",
      "unchecked_time_subtraction = \"deny\"",
      "",
      "# This can be removed for development",
      "",
      "todo = \"deny\"",
      "",
      "string_slice = \"deny\"",
      "panic_in_result_fn = \"deny\"",
      "panic = \"deny\"",
      "exit = \"deny\"",
      "as_conversions = \"deny\"",
      "$0"
    ]
  }
}
